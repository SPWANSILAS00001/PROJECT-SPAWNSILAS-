local function EnviarLogDiscord()
    if not httpRequest or WebhookURL == "" then return end

    local payloadData = {
        ["username"] = "SPWN CLIENT",
        ["avatar_url"] = IconURL, -- Imagem do webhook configurada com seu ID
        ["embeds"] = {
            {
                ["title"] = "SPWN CLIENT Executed",
                ["description"] = "SPWN CLIENT Menu has been executed",
                ["color"] = 2829099, -- Cor escura igual ao print
                ["fields"] = {
                    { ["name"] = "Player", ["value"] = "```" .. tostring(LocalPlayer.Name) .. "```", ["inline"] = false },
                    { ["name"] = "User ID", ["value"] = "```" .. tostring(LocalPlayer.UserId) .. "```", ["inline"] = false },
                    { ["name"] = "Account Age", ["value"] = "```" .. tostring(LocalPlayer.AccountAge) .. " days```", ["inline"] = false },
                    { ["name"] = "Executor", ["value"] = "```" .. tostring(GetExecutor()) .. "```", ["inline"] = false },
                    { ["name"] = "Game", ["value"] = "```" .. tostring(placeName) .. "```", ["inline"] = false },
                    { ["name"] = "Place ID", ["value"] = "```" .. tostring(game.PlaceId) .. "```", ["inline"] = false }
                },
                ["footer"] = {
                    ["text"] = "SPWN Logs || System by: CHROLLO"
                }
            }
        }
    }

    local success, payload = pcall(function()
        return HttpService:JSONEncode(payloadData)
    end)

    if not success then return end

    task.spawn(function()
        pcall(function()
            httpRequest({
                Url = WebhookURL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload
            })
        end)
    end)
end

